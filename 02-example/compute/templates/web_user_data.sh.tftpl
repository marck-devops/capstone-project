#!/bin/bash
set -euxo pipefail

dnf install -y nginx python3-pip
pip3 install redis

cat > /etc/profile.d/redis.sh <<'ENVEOF'
export REDIS_HOST=${redis_host}
export REDIS_PORT=${redis_port}
ENVEOF

mkdir -p /opt/redis-check
cat > /opt/redis-check/redis_check.py <<'PYEOF'
${redis_check_script}
PYEOF
chmod 755 /opt/redis-check/redis_check.py

# Run the script as a web service on 0.0.0.0:${app_port}
cat > /etc/systemd/system/redis-check.service <<'UNITEOF'
[Unit]
Description=Redis check web app
After=network-online.target
Wants=network-online.target

[Service]
Environment=REDIS_HOST=${redis_host}
Environment=REDIS_PORT=${redis_port}
Environment=APP_HOST=0.0.0.0
Environment=APP_PORT=${app_port}
ExecStart=/usr/bin/python3 /opt/redis-check/redis_check.py --serve
Restart=always
DynamicUser=yes

[Install]
WantedBy=multi-user.target
UNITEOF

# nginx: proxy / to the app (the default server block includes default.d/*.conf)
cat > /etc/nginx/default.d/redis-check.conf <<'NGINXEOF'
location / {
    proxy_pass http://127.0.0.1:${app_port};
    proxy_set_header Host $host;
}
NGINXEOF

systemctl daemon-reload
systemctl enable --now redis-check
nginx -t
systemctl enable --now nginx
